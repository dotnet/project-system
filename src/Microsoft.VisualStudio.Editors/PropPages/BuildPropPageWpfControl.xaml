<UserControl x:ClassModifier="Friend"
             x:Class="Microsoft.VisualStudio.Editors.PropertyPages.BuildPropPageWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Colors are applied programmatically via ApplyVsThemeColors() to support
             dark/light/high-contrast themes. These styles use {x:Null} brushes as
             placeholders; the code-behind sets them at runtime using VSColorTheme. -->

        <!-- Category header style matching CPS designer (~20px, SemiBold, more spacing) -->
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,24,0,12"/>
        </Style>

        <!-- Separator line below page title only (CPS uses a thin line under "Build") -->
        <Style x:Key="TitleSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Property label style (bold, above the control — matches CPS PropertyTemplates) -->
        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>

        <!-- Description text style (gray subtext — CPS uses SupportTextBrushKey) -->
        <Style x:Key="PropertyDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Shared TextBox style -->
        <Style x:Key="PropertyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <!-- Shared ComboBox style with custom template for dark theme support.
             Width is constrained via Border wrapper on each ComboBox instance. -->
        <Style x:Key="PropertyComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" BorderThickness="1,0,0,0"
                                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="8,4,24,4" HorizontalAlignment="Left"
                                              VerticalAlignment="Center" IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter>
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared CheckBox style (CPS BoolPropertyValueTemplate: bold content) -->
        <Style x:Key="PropertyCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Shared RadioButton style -->
        <Style x:Key="PropertyRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark-themed ScrollBar: replaces the default Aero Chrome-based template
             which ignores SystemColors overrides. Uses simple Track with transparent buttons. -->
        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#666666" CornerRadius="4"
                                                            Margin="2,0,2,0" MinHeight="20"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ============================================ -->
        <!-- LEFT NAV: Section navigation (matches CPS) -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Left" Width="160" Margin="0,12,0,0" Padding="0,0,8,0"
                x:Name="navBorder">
            <StackPanel x:Name="navPanel" VerticalAlignment="Top">
                <TextBlock x:Name="navGeneral" Text="General" Cursor="Hand"
                           Foreground="White"
                           Margin="4,2,4,2" Padding="8,4" FontSize="13"
                           MouseLeftButtonDown="NavItem_Click" Tag="sectionGeneral"/>
                <TextBlock x:Name="navErrorsAndWarnings" Text="Errors and warnings" Cursor="Hand"
                           Foreground="White"
                           Margin="4,2,4,2" Padding="8,4" FontSize="13"
                           MouseLeftButtonDown="NavItem_Click" Tag="sectionErrorsAndWarnings"/>
                <TextBlock x:Name="navTreatWarnings" Text="Treat warnings as errors" Cursor="Hand"
                           Foreground="White"
                           Margin="4,2,4,2" Padding="8,4" FontSize="13"
                           MouseLeftButtonDown="NavItem_Click" Tag="sectionTreatWarnings"/>
                <TextBlock x:Name="navOutput" Text="Output" Cursor="Hand"
                           Foreground="White"
                           Margin="4,2,4,2" Padding="8,4" FontSize="13"
                           MouseLeftButtonDown="NavItem_Click" Tag="sectionOutput"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- RIGHT: Scrollable content area -->
        <!-- ============================================ -->
        <ScrollViewer x:Name="contentScrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="16,0,16,16">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="16,0,16,0">

                <!-- Page title (matches CPS "Build" heading — large, light weight) -->
                <TextBlock Text="Build" FontSize="28" FontWeight="Light" Margin="0,12,0,4"/>
                <Border Style="{StaticResource TitleSeparatorStyle}"/>

                <!-- ============================================ -->
                <!-- GENERAL -->
                <!-- ============================================ -->
                <StackPanel x:Name="sectionGeneral">
                    <TextBlock Text="General" Style="{StaticResource CategoryHeaderStyle}" Margin="0,8,0,8"/>

                    <!-- Conditional compilation symbols -->
                    <TextBlock Text="Conditional compilation symbols" Style="{StaticResource PropertyLabelStyle}"/>
                    <TextBlock Text="Specifies symbols on which to perform conditional compilation."
                               Style="{StaticResource PropertyDescriptionStyle}"/>
                    <TextBox x:Name="txtConditionalCompilationSymbols" Style="{StaticResource PropertyTextBoxStyle}"/>

                    <!-- Define DEBUG constant -->
                    <CheckBox x:Name="chkDefineDebug" Content="Define DEBUG constant"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>

                    <!-- Define TRACE constant -->
                    <CheckBox x:Name="chkDefineTrace" Content="Define TRACE constant"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>

                    <!-- Platform target -->
                    <TextBlock Text="Platform target" Style="{StaticResource PropertyLabelStyle}"/>
                    <TextBlock Text="Specifies the processor to be targeted by the output file."
                               Style="{StaticResource PropertyDescriptionStyle}"/>
                    <Border Width="300" HorizontalAlignment="Left" Margin="0,0,0,4"><ComboBox x:Name="cboPlatformTarget" Style="{StaticResource PropertyComboBoxStyle}" IsEditable="False"/></Border>

                    <!-- Nullable -->
                    <TextBlock x:Name="lblNullable" Text="Nullable" Style="{StaticResource PropertyLabelStyle}"/>
                    <TextBlock Text="Specifies the project-wide C# nullable context."
                               Style="{StaticResource PropertyDescriptionStyle}"/>
                    <Border Width="300" HorizontalAlignment="Left" Margin="0,0,0,4"><ComboBox x:Name="cboNullable" Style="{StaticResource PropertyComboBoxStyle}" IsEditable="False"/></Border>

                    <!-- Prefer 32-bit -->
                    <CheckBox x:Name="chkPrefer32Bit" Content="Prefer 32-bit"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>

                    <!-- Prefer native ARM64 -->
                    <CheckBox x:Name="chkPreferNativeArm64" Content="Prefer native ARM64"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>

                    <!-- Allow unsafe code -->
                    <CheckBox x:Name="chkAllowUnsafeCode" Content="Allow unsafe code"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>

                    <!-- Optimize code -->
                    <CheckBox x:Name="chkOptimizeCode" Content="Optimize code"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>
                </StackPanel>

                <!-- ============================================ -->
                <!-- ERRORS AND WARNINGS -->
                <!-- ============================================ -->
                <StackPanel x:Name="sectionErrorsAndWarnings">
                    <TextBlock Text="Errors and warnings" Style="{StaticResource CategoryHeaderStyle}"/>

                    <!-- Warning level -->
                    <TextBlock Text="Warning level" Style="{StaticResource PropertyLabelStyle}"/>
                    <Border Width="300" HorizontalAlignment="Left" Margin="0,0,0,4"><ComboBox x:Name="cboWarningLevel" Style="{StaticResource PropertyComboBoxStyle}" IsEditable="False"/></Border>

                    <!-- Suppress specific warnings -->
                    <TextBlock Text="Suppress specific warnings" Style="{StaticResource PropertyLabelStyle}"/>
                    <TextBox x:Name="txtSupressWarnings" Style="{StaticResource PropertyTextBoxStyle}"/>
                </StackPanel>

                <!-- ============================================ -->
                <!-- TREAT WARNINGS AS ERRORS -->
                <!-- ============================================ -->
                <StackPanel x:Name="sectionTreatWarnings">
                    <TextBlock Text="Treat warnings as errors" Style="{StaticResource CategoryHeaderStyle}"/>

                    <!-- Warning treatment radio buttons -->
                    <RadioButton x:Name="rbWarningNone" Content="None"
                                 Style="{StaticResource PropertyRadioButtonStyle}"/>
                    <RadioButton x:Name="rbWarningAll" Content="All"
                                 Style="{StaticResource PropertyRadioButtonStyle}"/>
                    <RadioButton x:Name="rbWarningSpecific" Content="Specific warnings"
                                 Style="{StaticResource PropertyRadioButtonStyle}"/>

                    <!-- Specific warnings text -->
                    <TextBox x:Name="txtSpecificWarnings" Style="{StaticResource PropertyTextBoxStyle}" Margin="24,0,0,4"/>
                </StackPanel>

                <!-- ============================================ -->
                <!-- OUTPUT -->
                <!-- ============================================ -->
                <StackPanel x:Name="sectionOutput">
                    <TextBlock Text="Output" Style="{StaticResource CategoryHeaderStyle}"/>

                    <!-- Output path -->
                    <TextBlock Text="Output path" Style="{StaticResource PropertyLabelStyle}"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button x:Name="btnOutputPathBrowse" Content="Browse..." DockPanel.Dock="Right"
                                Padding="12,4" Margin="8,0,0,0"/>
                        <TextBox x:Name="txtOutputPath" Style="{StaticResource PropertyTextBoxStyle}" Margin="0"/>
                    </DockPanel>

                    <!-- XML documentation file -->
                    <CheckBox x:Name="chkXMLDocumentationFile" Content="XML documentation file"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>
                    <TextBox x:Name="txtXMLDocumentationFile" Style="{StaticResource PropertyTextBoxStyle}" Margin="24,0,100,4"/>

                    <!-- Register for COM interop -->
                    <CheckBox x:Name="chkRegisterForCOM" Content="Register for COM interop"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>

                    <!-- Generate serialization assembly -->
                    <TextBlock x:Name="lblSGenOption" Text="Generate serialization assembly" Style="{StaticResource PropertyLabelStyle}"/>
                    <Border Width="300" HorizontalAlignment="Left" Margin="0,0,0,4"><ComboBox x:Name="cboSGenOption" Style="{StaticResource PropertyComboBoxStyle}" IsEditable="False"/></Border>

                    <!-- Advanced button -->
                    <Button x:Name="btnAdvanced" Content="Advanced..." Padding="12,6" Margin="0,12,0,8"
                            HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Bottom spacer -->
                <Border Height="20"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>




