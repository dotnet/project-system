<UserControl x:ClassModifier="Friend"
             x:Class="Microsoft.VisualStudio.Editors.PropertyPages.DebugPropPageWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Colors are applied programmatically via ApplyVsThemeColors() to support
             dark/light/high-contrast themes. These styles use {x:Null} brushes as
             placeholders; the code-behind sets them at runtime using VSColorTheme. -->

        <!-- Category header style matching CPS designer (~20px, SemiBold, more spacing) -->
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,24,0,12"/>
        </Style>

        <!-- Separator line below page title only (CPS uses a thin line under "Debug") -->
        <Style x:Key="TitleSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Property label style (bold, above the control — matches CPS PropertyTemplates) -->
        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>

        <!-- Description text style (gray subtext — CPS uses SupportTextBrushKey) -->
        <Style x:Key="PropertyDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Shared TextBox style -->
        <Style x:Key="PropertyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <!-- Shared ComboBox style with custom dark template. ClipToBounds on each
             instance prevents the template from rendering beyond Border wrapper. -->
        <Style x:Key="PropertyComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" BorderThickness="1,0,0,0"
                                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="8,4,24,4" HorizontalAlignment="Left"
                                              VerticalAlignment="Center" IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter>
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared CheckBox style (CPS BoolPropertyValueTemplate: bold content) -->
        <Style x:Key="PropertyCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Shared RadioButton style -->
        <Style x:Key="PropertyRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark vertical scrollbar. Only overrides Vertical orientation.
             Uses Track with transparent RepeatButtons and themed Thumb. -->
        <Style x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="14"/>
                    <Setter Property="MinWidth" Value="14"/>
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#2D2D30">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand"
                                                  Height="14" Opacity="0" Focusable="False"/>
                                    <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#686868" CornerRadius="3"
                                                                Margin="3,0,3,0" MinHeight="20"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                    <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand"
                                                  Height="14" Opacity="0" Focusable="False"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ============================================ -->
        <!-- LEFT NAV: Section navigation (matches CPS) -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Left" Width="160" Margin="0,12,0,0" Padding="0,0,8,0"
                x:Name="navBorder">
            <StackPanel x:Name="navPanel" VerticalAlignment="Top">
                <TextBlock x:Name="navStartAction" Text="Start action" Cursor="Hand"
                           Foreground="White"
                           Margin="4,2,4,2" Padding="8,4" FontSize="13"
                           MouseLeftButtonDown="NavItem_Click" Tag="sectionStartAction"/>
                <TextBlock x:Name="navStartOptions" Text="Start options" Cursor="Hand"
                           Foreground="White"
                           Margin="4,2,4,2" Padding="8,4" FontSize="13"
                           MouseLeftButtonDown="NavItem_Click" Tag="sectionStartOptions"/>
                <TextBlock x:Name="navDebuggerEngines" Text="Debugger engines" Cursor="Hand"
                           Foreground="White"
                           Margin="4,2,4,2" Padding="8,4" FontSize="13"
                           MouseLeftButtonDown="NavItem_Click" Tag="sectionDebuggerEngines"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- RIGHT: Scrollable content area -->
        <!-- ============================================ -->
        <ScrollViewer x:Name="contentScrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="16,0,16,16">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="16,0,16,0">

                <!-- Page title (matches CPS "Debug" heading — large, light weight) -->
                <TextBlock Text="Debug" FontSize="28" FontWeight="Light" Margin="0,12,0,4"/>
                <Border Style="{StaticResource TitleSeparatorStyle}"/>

                <!-- ============================================ -->
                <!-- START ACTION -->
                <!-- ============================================ -->
                <StackPanel x:Name="sectionStartAction">
                    <TextBlock Text="Start action" Style="{StaticResource CategoryHeaderStyle}" Margin="0,8,0,8"/>

                    <!-- Start project -->
                    <RadioButton x:Name="rbStartProject" Content="Start project" GroupName="StartAction"
                                 Style="{StaticResource PropertyRadioButtonStyle}"/>

                    <!-- Start external program -->
                    <RadioButton x:Name="rbStartProgram" Content="Start external program" GroupName="StartAction"
                                 Style="{StaticResource PropertyRadioButtonStyle}"/>
                    <DockPanel Margin="24,0,0,4">
                        <Button x:Name="btnStartProgramBrowse" Content="Browse..." DockPanel.Dock="Right"
                                Padding="12,4" Margin="8,0,0,0"/>
                        <TextBox x:Name="txtStartProgram" Style="{StaticResource PropertyTextBoxStyle}" Margin="0"/>
                    </DockPanel>

                    <!-- Start browser with URL -->
                    <RadioButton x:Name="rbStartURL" Content="Start browser with URL" GroupName="StartAction"
                                 Style="{StaticResource PropertyRadioButtonStyle}"/>
                    <TextBox x:Name="txtStartURL" Style="{StaticResource PropertyTextBoxStyle}" Margin="24,0,0,4"/>
                </StackPanel>

                <!-- ============================================ -->
                <!-- START OPTIONS -->
                <!-- ============================================ -->
                <StackPanel x:Name="sectionStartOptions">
                    <TextBlock Text="Start options" Style="{StaticResource CategoryHeaderStyle}"/>

                    <!-- Command line arguments -->
                    <TextBlock Text="Command line arguments" Style="{StaticResource PropertyLabelStyle}"/>
                    <TextBox x:Name="txtCommandLineArgs" Style="{StaticResource PropertyTextBoxStyle}"
                             AcceptsReturn="False" TextWrapping="Wrap" MinHeight="80"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- Working directory -->
                    <TextBlock Text="Working directory" Style="{StaticResource PropertyLabelStyle}"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button x:Name="btnWorkingDirBrowse" Content="Browse..." DockPanel.Dock="Right"
                                Padding="12,4" Margin="8,0,0,0"/>
                        <TextBox x:Name="txtWorkingDirectory" Style="{StaticResource PropertyTextBoxStyle}" Margin="0"/>
                    </DockPanel>

                    <!-- Use remote machine -->
                    <CheckBox x:Name="chkRemoteDebugEnabled" Content="Use remote machine"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>
                    <TextBox x:Name="txtRemoteDebugMachine" Style="{StaticResource PropertyTextBoxStyle}" Margin="24,0,0,4"/>

                    <!-- Authentication mode -->
                    <TextBlock x:Name="lblAuthenticationMode" Text="Authentication mode" Style="{StaticResource PropertyLabelStyle}"/>
                    <Border Width="300" HorizontalAlignment="Left" Margin="0,0,0,4" ClipToBounds="True">
                        <ComboBox x:Name="cboAuthenticationMode" Style="{StaticResource PropertyComboBoxStyle}" IsEditable="False"/>
                    </Border>
                </StackPanel>

                <!-- ============================================ -->
                <!-- DEBUGGER ENGINES -->
                <!-- ============================================ -->
                <StackPanel x:Name="sectionDebuggerEngines">
                    <TextBlock Text="Debugger engines" Style="{StaticResource CategoryHeaderStyle}"/>

                    <!-- Enable native code debugging -->
                    <CheckBox x:Name="chkEnableUnmanagedDebugging" Content="Enable native code debugging"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>

                    <!-- Enable SQL Server debugging -->
                    <CheckBox x:Name="chkEnableSQLServerDebugging" Content="Enable SQL Server debugging"
                              Style="{StaticResource PropertyCheckBoxStyle}"/>
                </StackPanel>

                <!-- Bottom spacer -->
                <Border Height="20"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
